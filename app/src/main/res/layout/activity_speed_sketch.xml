<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F10">

    <com.taydox.hudtool.FloatingSquaresView
        android:id="@+id/floatingSquaresView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#DD101010"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/toolbar_title_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HUD"
                    android:textColor="#00C0BF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:shadowColor="#00C0BF"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="12"/>

                <View
                    android:layout_width="1.5dp"
                    android:layout_height="20dp"
                    android:background="#3A3A3A"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/tvSpeedSketchTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPEED SKETCH"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"/>

                <com.taydox.hudtool.GlimmerBadgeView
                    android:id="@+id/glimmerProBadge"
                    android:layout_width="120dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="10dp"/>

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- SETUP SCREEN -->
    <ScrollView
        android:id="@+id/llSetupScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="24dp"
            android:paddingBottom="48dp"
            android:paddingHorizontal="32dp">

            <!-- Welcome Onboarding Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/image_container_bg"
                android:padding="20dp"
                android:layout_marginBottom="32dp">

                <TextView
                    android:id="@+id/tvSpeedSketchWelcomeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to Speed Sketch!"
                    android:textColor="#00C0BF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvSpeedSketchWelcomeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="This tool is designed to help you practice and improve your drawing skills under time pressure. To get started, load an album from your library and set your timer intervals. Once you click start, your references will overlay sequentially based on your timer. Challenge yourself to capture the reference within the time limit!"
                    android:textColor="#A0AAB0"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"/>

            </LinearLayout>

            <!-- Album selector -->
            <TextView
                android:id="@+id/tvSelectAlbumLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="// SELECT REFERENCE ALBUM"
                android:textColor="#A0AAB0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/btnSelectAlbum"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/image_container_bg"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="32dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvSelectedAlbum"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Choose your practice set..."
                    android:textColor="#606C75"
                    android:textSize="15sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶"
                    android:textColor="#00C0BF"
                    android:textSize="16sp"/>
            </LinearLayout>

            <!-- Mode Selection -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="// SESSION MODE"
                android:textColor="#A0AAB0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <RadioGroup
                android:id="@+id/rgSessionMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="32dp">

                <RadioButton
                    android:id="@+id/rbModeFixed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fixed Interval"
                    android:textColor="#FFFFFF"
                    android:buttonTint="#00C0BF"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/rbModeClass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Class Mode"
                    android:textColor="#FFFFFF"
                    android:buttonTint="#00C0BF"/>
            </RadioGroup>

            <!-- Timer duration -->
            <TextView
                android:id="@+id/tvTimerLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="// TIMER PER POSE"
                android:textColor="#A0AAB0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="32dp">

                <TextView
                    android:id="@+id/chip30s"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="30s"
                    android:gravity="center"
                    android:textColor="#A0AAB0"
                    android:textSize="13sp"
                    android:background="@drawable/timer_chip_bg"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chip1m"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="1 min"
                    android:gravity="center"
                    android:textColor="#A0AAB0"
                    android:textSize="13sp"
                    android:background="@drawable/timer_chip_bg"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chip2m"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="2 min"
                    android:gravity="center"
                    android:textColor="#A0AAB0"
                    android:textSize="13sp"
                    android:background="@drawable/timer_chip_bg"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chip5m"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="5 min"
                    android:gravity="center"
                    android:textColor="#A0AAB0"
                    android:textSize="13sp"
                    android:background="@drawable/timer_chip_bg"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>

            <!-- Options -->
            <TextView
                android:id="@+id/tvOptionsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="// PREFERENCES"
                android:textColor="#A0AAB0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvShuffleLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Shuffle Session"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchShuffle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="#00C0BF"
                    app:trackTint="#1A6060"/>

            </LinearLayout>

            <!-- Start button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartSession"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="ENTER SPEED SKETCH"
                android:textColor="#0D0F10"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                app:backgroundTint="#00C0BF"
                app:cornerRadius="8dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- SESSION SCREEN — handled by SpeedSketchService but Activity can show preview/stats -->
    <FrameLayout
        android:id="@+id/flSessionScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#0D0F10">
        <!-- Overlay will actually be on top of other apps, but we can put a "Session in progress" UI here if they switch back to the app -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SESSION IN PROGRESS"
                android:textColor="#00C0BF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HUD is currently overlaying your practice session. Switch to your art app to start drawing."
                android:textColor="#A0AAB0"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginBottom="32dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopSessionManual"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="END SESSION NOW"
                android:textColor="#FFFFFF"
                app:backgroundTint="#3A1A1A"
                app:strokeColor="#7A3B3B"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"/>
        </LinearLayout>
    </FrameLayout>

    <!-- SUMMARY SCREEN -->
    <LinearLayout
        android:id="@+id/llSummaryScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="40dp"
        android:background="#0D0F10"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSessionCompleteLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DRILL COMPLETE"
            android:textColor="#00C0BF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:shadowColor="#00C0BF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvGoodWorkLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your hands are warm. Time to create."
            android:textColor="#606C75"
            android:textSize="14sp"
            android:layout_marginBottom="48dp"/>

        <!-- Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="48dp">

            <!-- Poses completed -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/image_container_bg"
                android:padding="20dp"
                android:layout_marginEnd="12dp">

                <TextView
                    android:id="@+id/tvSummaryPoses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#00C0BF"
                    android:textSize="40sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvPosesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POSES"
                    android:textColor="#A0AAB0"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>
            </LinearLayout>

            <!-- Total time -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/image_container_bg"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvSummaryTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0m"
                    android:textColor="#00C0BF"
                    android:textSize="40sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvMinutesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MINUTES"
                    android:textColor="#A0AAB0"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>
            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSessionAgain"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="RE-START DRILL"
            android:textColor="#0D0F10"
            android:textStyle="bold"
            app:backgroundTint="#00C0BF"
            app:cornerRadius="8dp"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSummaryBack"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="RETURN TO HUD"
            android:textColor="#00C0BF"
            android:textStyle="bold"
            app:backgroundTint="#1A1A1A"
            app:strokeColor="#00C0BF"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>