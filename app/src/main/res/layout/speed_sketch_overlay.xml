<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/speedSketchRoot"
    android:layout_width="240dp"
    android:layout_height="280dp"
    android:background="#66000000"
    android:padding="2dp">

    <!-- Top Drag Handle -->
    <LinearLayout
        android:id="@+id/dragHandle"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:background="#33000000"
        android:gravity="center"
        android:orientation="horizontal">
        <View
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:background="#80FFFFFF"/>
    </LinearLayout>

    <!-- Main Content Area -->
    <FrameLayout
        android:id="@+id/imageContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/llBottomControls"
        android:layout_below="@id/dragHandle">

        <ImageView
            android:id="@+id/ivPoseImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:scaleType="fitCenter"/>

        <com.taydox.hudtool.BorderTimerView
            android:id="@+id/borderTimer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- Smaller digital timer fallback -->
        <TextView
            android:id="@+id/tvTimerDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:text="60"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </FrameLayout>

    <!-- Bottom Controls -->
    <LinearLayout
        android:id="@+id/llBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#33000000"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvPoseCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 / 12"
            android:textColor="#00C0BF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginVertical="2dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@android:drawable/ic_media_pause"
                android:background="@android:color/transparent"
                app:tint="#00C0BF"/>

            <ImageButton
                android:id="@+id/btnSkip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/ic_skip"
                android:background="@android:color/transparent"
                app:tint="#00C0BF"/>

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="@android:color/transparent"
                app:tint="#FF6B6B"/>

        </LinearLayout>
    </LinearLayout>

    <!-- Resize Handle Bottom-Right -->
    <View
        android:id="@+id/resizeHandle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:background="@drawable/resize_handle_bg"/>

</RelativeLayout>