<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2A2A2A">

    <com.taydox.hudtool.FloatingSquaresView
        android:id="@+id/floatingSquaresView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#DD101010"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/toolbar_title_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HUD"
                    android:textColor="#00C0BF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:shadowColor="#00C0BF"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="12"/>

                <View
                    android:layout_width="1.5dp"
                    android:layout_height="20dp"
                    android:background="#3A3A3A"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/tvSettingsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SETTINGS"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"/>

                <com.taydox.hudtool.GlimmerBadgeView
                    android:id="@+id/glimmerProBadge"
                    android:layout_width="120dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="10dp"/>

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="40dp">

            <!-- // BEHAVIOR -->
            <TextView
                android:id="@+id/tvBehaviorLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="// BEHAVIOR"
                android:textColor="#A0AAB0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp"/>

            <!-- Auto-Hide Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAutoHideLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-Hide Controls"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/tvAutoHideSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fade out buttons after 10 seconds of inactivity"
                        android:textColor="#808080"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAutoHide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="#00C0BF"
                    app:trackTint="#1A6060"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF"
                android:layout_marginBottom="8dp"/>

            <!-- Keep Screen On -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvKeepScreenLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keep Screen On"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/tvKeepScreenSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prevent device from sleeping while overlay is active"
                        android:textColor="#808080"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchKeepScreenOn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="#00C0BF"
                    app:trackTint="#1A6060"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF"
                android:layout_marginBottom="32dp"/>

            <!-- // DEFAULT STARTUP VALUES -->
            <TextView
                android:id="@+id/tvDefaultStartupLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="// DEFAULT STARTUP VALUES"
                android:textColor="#A0AAB0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvDefaultOpacityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Default Opacity"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <SeekBar
                    android:id="@+id/sbDefaultOpacity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progress="75"
                    android:max="100"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:thumbTint="#00C0BF"
                    android:minHeight="8dp"/>

                <TextView
                    android:id="@+id/tvDefaultOpacityValue"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:text="75%"
                    android:textColor="#00C0BF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="end"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF"
                android:layout_marginBottom="32dp"/>

            <!-- // PERFORMANCE & AUDIO -->
            <TextView
                android:id="@+id/tvPerformanceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="// PERFORMANCE &amp; AUDIO"
                android:textColor="#A0AAB0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp"/>

            <!-- Haptic Feedback -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHapticLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Haptic Feedback"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/tvHapticSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vibrate when resizing or locking overlay"
                        android:textColor="#808080"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchHaptic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="#00C0BF"
                    app:trackTint="#1A6060"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF"
                android:layout_marginBottom="8dp"/>

            <!-- Sound Effects -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSoundEffectsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sound Effects"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/tvSoundEffectsSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Play audio cues for splash, expansion, and locking"
                        android:textColor="#808080"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSoundEffects"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="#00C0BF"
                    app:trackTint="#1A6060"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF"
                android:layout_marginBottom="32dp"/>

            <!-- // APPEARANCE -->
            <TextView
                android:id="@+id/tvAppearanceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="// APPEARANCE"
                android:textColor="#A0AAB0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvThemeModeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Theme Mode"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <RadioGroup
                    android:id="@+id/rgThemeMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbThemeAuto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto"
                        android:textColor="#A0AAB0"
                        android:buttonTint="#00C0BF"/>

                    <RadioButton
                        android:id="@+id/rbThemeLight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Light"
                        android:textColor="#A0AAB0"
                        android:buttonTint="#00C0BF"/>

                    <RadioButton
                        android:id="@+id/rbThemeDark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dark"
                        android:textColor="#A0AAB0"
                        android:buttonTint="#00C0BF"/>
                </RadioGroup>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp"/>

            <!-- Control Panel Scale -->
            <TextView
                android:id="@+id/tvPanelScaleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="// CONTROL PANEL SCALE"
                android:textColor="#A0AAB0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <SeekBar
                    android:id="@+id/sbPanelScale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progress="50"
                    android:max="100"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:thumbTint="#00C0BF"
                    android:minHeight="8dp"/>

                <TextView
                    android:id="@+id/tvPanelScaleValue"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:text="1.0x"
                    android:textColor="#00C0BF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="end"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="#1A000000"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PREVIEW"
                    android:textColor="#33FFFFFF"
                    android:textSize="10sp"
                    android:layout_gravity="top|start"
                    android:layout_margin="8dp"/>

                <LinearLayout
                    android:id="@+id/llDummyPanel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/toolbar_title_bg"
                    android:padding="4dp">
                    <TextView
                        android:id="@+id/btnDummyToggle"
                        android:layout_width="32dp"
                        android:layout_height="48dp"
                        android:text="‹"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/panel_btn_gray_bg"/>
                </LinearLayout>
            </FrameLayout>

            <!-- Reset button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetSettings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="RESET ALL SETTINGS"
                android:textColor="#FF6B6B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                app:backgroundTint="#3A1A1A"
                app:strokeColor="#7A3B3B"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettingsFeedback"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="REPORT A BUG / GIVE FEEDBACK"
                android:textColor="#00C0BF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                app:backgroundTint="#1A1A1A"
                app:strokeColor="#00C0BF"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>